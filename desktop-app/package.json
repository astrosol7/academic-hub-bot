{
  "name": "orbit-control-center",
  "version": "1.1.0",
  "description": "Orbit Control Center - Desktop shell for the SIT Academic Hub admin console",
  "main": "main.cjs",
  "homepage": "./",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dashboard:dev\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dashboard:dev": "npm --prefix ../dashboard run dev -- --host 127.0.0.1 --port 5173",
    "dashboard:build": "node scripts/build-dashboard.cjs",
    "pack": "npm run dashboard:build && electron-builder --dir",
    "dist": "npm run dashboard:build && electron-builder --win nsis"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "axios": "^1.6.0",
    "date-fns": "^2.30.0",
    "framer-motion": "^10.16.0",
    "lucide-react": "^1.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.28.0",
    "react-scripts": "5.0.1",
    "react-table": "^7.8.0",
    "react-virtualized": "^9.22.5",
    "recharts": "^2.12.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^8.2.2",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "typescript": "^4.9.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.academic-hub.orbit-control",
    "productName": "Orbit Control Center",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "dashboard-dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Orbit Control Center Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
